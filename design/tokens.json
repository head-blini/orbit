{
  "$description": "Orbit 디자인 토큰. 근거: .orbit/decisions.md '화면 디자인 방향 확정' 절, 상세는 .orbit/runs/20261114-graph-ui/DESIGN.md. 색은 4명암뿐이고 상태 색은 없다.",
  "color": {
    "paper": "#f8f8ec",
    "light": "#b4b8a4",
    "dark": "#5c6052",
    "ink": "#1c1e18"
  },
  "role": {
    "app-bg": "{color.light}",
    "panel-bg": "{color.paper}",
    "text": "{color.ink}",
    "text-muted": "{color.dark}",
    "border": "{color.ink}",
    "inverse-bg": "{color.ink}",
    "inverse-text": "{color.paper}",
    "wait-bg": "{color.light}",
    "bezel": "{color.dark}",
    "lcd": "{color.light}"
  },
  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "panel-gap": "8px",
    "panel-pad-y": "12px",
    "panel-pad-x": "16px"
  },
  "border": {
    "panel": "3px solid #1c1e18",
    "panel-shadow": "inset 0 0 0 2px #f8f8ec, inset 0 0 0 4px #1c1e18",
    "box": "2px solid #1c1e18",
    "box-fail": "2px dashed #1c1e18",
    "input-disabled": "2px dashed #5c6052",
    "chip": "1px solid #1c1e18",
    "node": "2px solid #1c1e18",
    "node-shadow": "inset 0 0 0 2px #f8f8ec, inset 0 0 0 3px #1c1e18",
    "node-shadow-wait": "inset 0 0 0 2px #b4b8a4, inset 0 0 0 3px #1c1e18",
    "node-run": "3px solid #1c1e18",
    "node-run-shadow": "inset 0 0 0 2px #f8f8ec, inset 0 0 0 4px #1c1e18",
    "node-fail": "2px dashed #1c1e18",
    "focus": "2px solid #1c1e18",
    "focus-on-bezel": "2px solid #f8f8ec",
    "focus-offset": "2px"
  },
  "radius": {
    "panel": "6px",
    "box": "0",
    "node": "6px",
    "pbar": "4px",
    "pbar-fill": "2px",
    "bezel": "6px 6px 24px 6px"
  },
  "font": {
    "family": {
      "pixel": "\"Galmuri11\", monospace",
      "body": "\"Segoe UI\", system-ui, sans-serif",
      "mono": "\"Cascadia Mono\", Consolas, monospace"
    },
    "size": {
      "meta": "11px",
      "pixel": "12px",
      "body": "13px",
      "brand": "24px"
    },
    "line-height": "1.5"
  },
  "graph": {
    "node-width": "168px",
    "node-height": "60px",
    "node-pad": "4px 10px",
    "node-pad-run": "3px 9px",
    "node-gap-y": "12px",
    "stage-gap-x": "48px",
    "edge-bus-x": "24px",
    "edge-width": "2",
    "edge-dash": "4 4",
    "scroll-pad": "4px"
  },
  "roadmap": {
    "$description": "run 20261114-roadmap-panel DESIGN.md. 막대 테두리·모서리는 border.chip, radius.pbar, radius.pbar-fill을 쓴다.",
    "mark-col": "16px",
    "item-gap": "2px",
    "bar-height": "8px",
    "summary-gap": "12px"
  },
  "topbar": {
    "$description": "run 20261114-roadmap-panel DESIGN.md. 한 줄 고정, 결과는 남는 폭에서 말줄임.",
    "gap": "12px",
    "status-max": "240px"
  },
  "terminal": {
    "$description": "run 20261115-terminal DESIGN.md. 아래 넓은 칸의 앱 내장 터미널(xterm). 색은 color 4명암 참조뿐, 새 색 없음. theme 키 이름은 xterm ITheme 그대로.",
    "font-family": "{font.family.mono}",
    "font-size": "{font.size.body}",
    "line-height": "1",
    "pad": "4px",
    "focus-offset": "-2px",
    "theme": {
      "background": "{color.paper}",
      "foreground": "{color.ink}",
      "cursor": "{color.ink}",
      "cursorAccent": "{color.paper}",
      "selectionBackground": "{color.light}",
      "selectionForeground": "{color.ink}",
      "selectionInactiveBackground": "{color.light}",
      "scrollbarSliderBackground": "{color.dark}",
      "scrollbarSliderHoverBackground": "{color.ink}",
      "scrollbarSliderActiveBackground": "{color.ink}",
      "black": "{color.ink}",
      "red": "{color.ink}",
      "green": "{color.dark}",
      "yellow": "{color.dark}",
      "blue": "{color.dark}",
      "magenta": "{color.dark}",
      "cyan": "{color.dark}",
      "white": "{color.light}",
      "brightBlack": "{color.dark}",
      "brightRed": "{color.ink}",
      "brightGreen": "{color.dark}",
      "brightYellow": "{color.dark}",
      "brightBlue": "{color.dark}",
      "brightMagenta": "{color.dark}",
      "brightCyan": "{color.dark}",
      "brightWhite": "{color.paper}"
    }
  },
  "design": {
    "$description": "run 20261115-graph-edit DESIGN.md. 설계 그래프(그래프 칸 설계 모드)와 노드 속성 폼(오른쪽 위 칸 설계 모드). 새 색 없음. 노드 크기·열 간격·행 간격·간선 굵기·점선은 graph 키를 그대로 쓴다.",
    "align": "top",
    "lane-near": "12px",
    "lane-step": "8px",
    "lane-count": "4",
    "msg-height": "20px",
    "mode-gap": "{space.1}",
    "form-gap": "{space.2}",
    "label-gap": "2px",
    "input-border": "{border.box}",
    "input-invalid": "{border.box-fail}",
    "input-pad": "2px 6px",
    "input-min-height": "{layout.target-min}",
    "select-pad-right": "22px",
    "num-col": "72px",
    "task-rows": "3",
    "schema-rows": "4"
  },
  "layout": {
    "columns": "minmax(220px, 1fr) minmax(0, 2.6fr) minmax(280px, 1.2fr)",
    "rows": "auto minmax(0, 3fr) minmax(0, 2fr)",
    "min-width": "960px",
    "min-height": "640px",
    "target-min": "24px"
  },
  "motion": {
    "blink": "1s step-end infinite",
    "flow": "0.8s linear infinite",
    "bar": "1.2s steps(6) infinite",
    "reduced": "prefers-reduced-motion: reduce 이면 모두 멈춤"
  }
}
