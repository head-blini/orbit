{
  "extraKnownMarketplaces": {
    "orbit-local": { "source": { "source": "directory", "path": "./" } }
  },
  "enabledPlugins": { "orbit@orbit-local": true },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/harness/hooks/gate.mjs"], "timeout": 10 }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)"
    ]
  }
}
